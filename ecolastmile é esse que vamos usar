function carregarBairros(){
 const cidade=citySelect.value;
 const bairros=bairrosPorCidade[cidade] || [];
 neighborhoodSelect.innerHTML=bairros.length ? '<option value="">Selecione um bairro</option>'+bairros.sort((a,b)=>a.localeCompare(b,'pt-BR')).map(b=>`<option value="${escapeHtml(b)}">${escapeHtml(b)}</option>`).join('') : '<option value="">Bairros não cadastrados para esta cidade</option>';
 neighborhoodSelect.disabled=!cidade || bairros.length===0;
}

citySelect.addEventListener('change',carregarBairros);

document.getElementById('deliveryForm').addEventListener('submit',e=>{
 e.preventDefault();
 const address=document.getElementById('address').value.trim();
 const neighborhood=document.getElementById('neighborhood').value.trim();
 const stateName=stateSelect.options[stateSelect.selectedIndex]?.text||'';
 if(!stateSelect.value||!address||!neighborhood)return;
 const fullAddress=neighborhood+', '+address+', '+stateName;
 const dist=estimateDistance(address);

 const sel=document.getElementById('vehicle');
 deliveries.push({name:document.getElementById('recipient').value.trim(),address:fullAddress,neighborhood,city:address,state:stateName,distance:dist,vehicle:sel.options[sel.selectedIndex].text,factor:Number(sel.value)});
 optimized=true;render();e.target.reset(); citySelect.innerHTML='<option value="">Selecione primeiro o estado</option>'; citySelect.disabled=true; neighborhoodSelect.disabled=true;
});
window.removeDelivery=i=>{deliveries.splice(i,1);optimized=true;render();};

render();
</script>
